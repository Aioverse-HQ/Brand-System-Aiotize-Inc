{
  "name": "@aiotize/icons",
  "version": "0.1.0",
  "description": "SVG icons and React components for Aiotize brand system",
  "license": "Apache-2.0",
  "author": "Aiotize Inc",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svg/*": "./src/icons/*.svg"
  },
  "files": [
    "dist",
    "src/icons"
  ],
  "scripts": {
    "build": "node scripts/build.js && tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@types/react": "^18.2.0",
    "svgo": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
